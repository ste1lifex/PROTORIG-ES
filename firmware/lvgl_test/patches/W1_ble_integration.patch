@@ -10,15 +10,16 @@ CONFIG_FREERTOS             =y
 CONFIG_SHELL                =y
 
 # ---------------------------------------------------------------------------
-# BLE（M2 W1 已完成集成，按"先地基后楼层"推迟到 R4 再打开）
-#
-#   R0/R1 基线不编 BLE：BLE 集成源码与补丁保留（ble_link/ble_svc/ble_ui +
-#   patches/W1_ble_integration.patch，git 分支 w1-ble-integration）。
-#   R4 恢复时把下面三行加回来：
-#     CONFIG_BLUETOOTH            =y
-#     CONFIG_RF                   =y
-#     CONFIG_BTBLECONTROLLER_LIB  =ble1m0s1bredr0
+# BLE（M2，探针并入；W1 2026-10-28）
+#   * BL616 BLE-only：1 连接 / 从机，libbtblecontroller 用 ble1m0s1bredr0
+#   * CONFIG_RF 是 rfparam_init()（PHY 校准）需要的
+#   * 不要加 CONFIG_BFLB_MTD / CONFIG_PARTITION / CONFIG_LITTLEFS：
+#     CONFIG_BT_SETTINGS 默认 n，host 不用 flash KV；将来做绑定再一起加
+#   * 不要加 CONFIG_BT_OAD_SERVER：OAD 需要额外分区，M2 不做 BLE OTA
 # ---------------------------------------------------------------------------
+CONFIG_BLUETOOTH            =y
+CONFIG_RF                   =y
+CONFIG_BTBLECONTROLLER_LIB  =ble1m0s1bredr0
 
 # USB CDC 虚拟串口控制台（printf / shell 都走 USB-C）
 CONFIG_CHERRYUSB                 =y
